GATI_ENV=development
# Gere a configuração local com python scripts/prepare_env.py.
GATI_SECRET_KEY=
GATI_ALLOWED_HOSTS=localhost,127.0.0.1
GATI_CSRF_ORIGINS=
GATI_PUBLIC_URL=http://127.0.0.1:8765
PGDATABASE=gati
PGUSER=gati
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
# Host remoto (Neon): o Django exige verificacao TLS completa do servidor.
# PGSSLMODE=verify-full
# PGSSLROOTCERT=CAMINHO_PARA_CA_PEM  # opcional; usa certifi por padrao
GATI_CLAMAV_HOST=127.0.0.1
GATI_CLAMAV_PORT=3310
# Para produção: HTTPS, credenciais exclusivas e provedor SMTP homologado.
GATI_FROM_EMAIL=gati@example.invalid
GATI_SMTP_HOST=
GATI_SMTP_USER=
GATI_SMTP_PASSWORD=
